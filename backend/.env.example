# Salin ke backend/.env lalu isi nilai asli. Jangan commit nilai rahasia ke file ini.
PORT=5000
# development (default bila kosong) | staging | production. Nilai lain = backend gagal start.
# staging mengaktifkan pintu cek soal /api/staging TANPA login; pakai hanya dengan DB staging terpisah.
APP_ENV=development
# MongoDB lokal dari Docker (docker compose up -d mongodb), replica set rs0 agar transaksi aktif.
# Backend di dalam Docker memakai URI dari docker-compose.yml; nilai ini untuk `npm run dev` di host.
MONGO_URI=mongodb://localhost:27017/project_assessment?directConnection=true

# Foto soal di Cloudinary. Nilai ini harus sama di lokal, staging, dan production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nolla/soal
CLOUDINARY_COMPLAINTS_FOLDER=nolla/complaints

ANALYTICS_ENABLED=true
ANALYTICS_ENVIRONMENT=tester

FRONTEND_URL=http://localhost:5173

# Minimal 32 karakter acak, mis.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<random-secret>
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=1d
REMEMBER_ME_EXPIRES_IN=30d

GOOGLE_CLIENT_ID=<google-oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=<smtp-user@example.com>
SMTP_PASS=<smtp-app-password>

# Analytics (lihat docs/hasil-perbatch.md, Batch 4). Nonaktif kecuali "true".
# Aktifkan hanya setelah dasar pemrosesan data anak (UU PDP) ditetapkan.
ANALYTICS_ENABLED=false
ANALYTICS_ENVIRONMENT=development
APP_VERSION=
ANALYTICS_NOTICE_VERSION=
# Kosong = tanpa penghapusan otomatis (TTL).
ANALYTICS_RETENTION_DAYS=
# Domain email akun internal/uji, dipisah koma (akun seed memakai example.com).
ANALYTICS_INTERNAL_EMAIL_DOMAINS=example.com

# Saklar fitur paket (true/false/1/0/on/off, kosong = aktif). false = semua bab terbuka,
# kuis tanpa batas, trial & katalog nonaktif (harga di bawah tidak divalidasi).
PREMIUM_FEATURE_ENABLED=true

# Harga paket Premium (Rupiah, bilangan bulat). PRICE kosong = paket belum ditawarkan.
# DISCOUNT_TYPE: none | flat | percentage. flat = potongan Rupiah (< PRICE);
# percentage = persen 0–100 eksklusif (maks. 2 desimal, dibulatkan ke rupiah terdekat).
# Isian salah membuat backend gagal start. Ubah harga cukup restart backend.
# Angka di bawah hanya contoh format, bukan harga resmi.
PREMIUM_WEEKLY_PRICE=9999
PREMIUM_WEEKLY_DISCOUNT_TYPE=none
PREMIUM_WEEKLY_DISCOUNT_VALUE=0
PREMIUM_MONTHLY_PRICE=29999
PREMIUM_MONTHLY_DISCOUNT_TYPE=percentage
PREMIUM_MONTHLY_DISCOUNT_VALUE=20
PREMIUM_YEARLY_PRICE=299999
PREMIUM_YEARLY_DISCOUNT_TYPE=flat
PREMIUM_YEARLY_DISCOUNT_VALUE=100000

# Midtrans Snap. Untuk pengembangan gunakan key Sandbox dan false.
# Pembelian aktif setelah Server Key, Client Key, dan Merchant ID diisi.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false
