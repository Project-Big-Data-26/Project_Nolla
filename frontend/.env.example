# URL backend; dinormalkan ke <skema>://<host>/api (lihat src/api/baseUrl.js).
VITE_API_BASE_URL=http://localhost:5000/api

# Pintu cek soal staging (/staging/cek-soal). Hanya "true" yang mengaktifkan; kosong/false =
# halaman tidak ikut di-build. Isi true hanya untuk build staging/dev, jangan untuk production.
VITE_ENABLE_STAGING_CHECK=false

# Konfigurasi Aplikasi
VITE_APP_NAME="Big Data"
