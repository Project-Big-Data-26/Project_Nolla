{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare:pdfjs": "node scripts/copy-pdfjs-assets.mjs",
    "predev": "npm run prepare:pdfjs",
    "dev": "vite",
    "prebuild": "npm run prepare:pdfjs",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:profil": "NO_COLOR=1 cypress run --spec 'cypress/e2e/auth/profile-*.cy.js' 2>&1 | tee cypress/reports/hasil-profil-$(date +%F).txt",
    "test:profil:pass": "NO_COLOR=1 cypress run --spec 'cypress/e2e/auth/profile-pass.cy.js' 2>&1 | tee cypress/reports/hasil-profil-pass-$(date +%F).txt",
    "test:profil:fail": "NO_COLOR=1 cypress run --spec 'cypress/e2e/auth/profile-fail.cy.js' 2>&1 | tee cypress/reports/hasil-profil-fail-$(date +%F).txt"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.20.0",
    "katex": "^0.18.9",
    "lucide-react": "^1.47.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-katex": "^3.1.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "cypress": "^15.21.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}