{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "dev": "vite",
    "test:login": "NO_COLOR=1 cypress run --spec 'cypress/e2e/login/login.cy.js' 2>&1 | tee cypress/reports/login/hasil-login-$(date +%F).txt",
    "test:smoke": "NO_COLOR=1 cypress run --spec 'cypress/e2e/smoke/*.cy.js' 2>&1 | tee cypress/reports/smoke/hasil-smoke-$(date +%F).txt",
    "test:login:token": "NO_COLOR=1 cypress run --spec 'cypress/e2e/login/login-token.cy.js' 2>&1 | tee cypress/reports/login/hasil-token-$(date +%F).txt",
    "test:logout": "NO_COLOR=1 cypress run --spec 'cypress/e2e/logout/logout.cy.js' 2>&1 | tee cypress/reports/logout/hasil-logout-$(date +%F).txt",
    "test:recovery": "NO_COLOR=1 cypress run --spec 'cypress/e2e/password-recovery/password-recovery.cy.js' 2>&1 | tee cypress/reports/password-recovery/hasil-recovery-$(date +%F).txt",
    "test:profil": "NO_COLOR=1 cypress run --spec 'cypress/e2e/profil/profile.cy.js' 2>&1 | tee cypress/reports/profil/hasil-profil-$(date +%F).txt",
    "test:landing": "NO_COLOR=1 cypress run --spec 'cypress/e2e/landing/landing.cy.js' 2>&1 | tee cypress/reports/landing/hasil-landing-$(date +%F).txt",
    "test:bab": "NO_COLOR=1 cypress run --spec 'cypress/e2e/bab/bab-pembelajaran.cy.js' 2>&1 | tee cypress/reports/bab/hasil-bab-$(date +%F).txt",
    "test:hasil": "NO_COLOR=1 cypress run --spec 'cypress/e2e/hasil-pembelajaran/hasil-pembelajaran.cy.js' 2>&1 | tee cypress/reports/hasil-pembelajaran/hasil-hasil-$(date +%F).txt",
    "cy:registrasi:pass": "NO_COLOR=1 cypress run --spec 'cypress/e2e/registrasi/registrasi-pass.cy.js' 2>&1 | tee cypress/reports/registrasi/hasil-registrasi-pass-$(date +%F).txt",
    "cy:registrasi:fail": "NO_COLOR=1 cypress run --spec 'cypress/e2e/registrasi/registrasi-fail.cy.js' 2>&1 | tee cypress/reports/registrasi/hasil-registrasi-fail-$(date +%F).txt",
    "cy:registrasi:otp": "NO_COLOR=1 cypress run --headed --browser chrome --spec 'cypress/e2e/registrasi/registrasi-otp.cy.js' 2>&1 | tee cypress/reports/registrasi/hasil-registrasi-otp-$(date +%F).txt"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.20.0",
    "jsxgraph": "^1.11.1",
    "katex": "^0.18.9",
    "katex-v016": "npm:katex@^0.16.47",
    "lucide-react": "^1.47.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-katex": "^3.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "cypress": "^15.21.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
